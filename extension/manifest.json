{
  "manifest_version": 3,
  "name": "Goodwork Job Manager",
  "version": "1.1.0",
  "description": "Manage Goodwork job listings from an admin dashboard tab.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Manage Goodwork jobs"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
